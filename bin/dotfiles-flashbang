#!/usr/bin/env bash
set -euo pipefail

# Toggle the anti-flashbang screen shader.
#
# This changes the running compositor only. `hyprctl reload`, a Hyprland
# restart, or a logout all clear it, which is deliberate: a screen shader that
# survives a bad edit is hard to get rid of. To keep it on permanently, set
# decoration.screen_shader in ~/.config/hypr/looknfeel.lua instead.

DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
SHADER="$DATA_HOME/dotfiles/shaders/anti-flashbang.glsl"
OPTION="decoration:screen_shader"
ACTION="toggle"

ok() { printf '\033[1;32m==>\033[0m %s\n' "$*"; }
die() { printf '\033[1;31merror:\033[0m %s\n' "$*" >&2; exit 1; }

usage() {
  cat <<'EOF'
Usage: dotfiles-flashbang [on|off|toggle|status]

Dim the screen in proportion to its own brightness, so a white window opening
at night never reaches full intensity.

  on      Enable the shader
  off     Disable the shader
  toggle  Switch between the two (default)
  status  Print the current state and exit

Hyprland supports one screen shader at a time, so enabling this replaces any
other screen shader currently set.
EOF
}

# Prints the shader path currently in use, or nothing when none is set.
current_shader() {
  local value

  value="$(hyprctl getoption "$OPTION" | sed -n 's/^str: //p')"
  [[ "$value" == "[[EMPTY]]" ]] && return 0
  printf '%s' "$value"
}

apply_shader() {
  local path="$1"
  local output

  # The path is interpolated into a Lua string literal, so refuse the two
  # characters that could terminate or escape it.
  [[ "$path" != *['"\']* ]] || die "Shader path contains unsupported characters: $path"

  output="$(hyprctl eval "hl.config({ decoration = { screen_shader = \"$path\" } })" 2>&1)" ||
    die "hyprctl eval failed: $output"
  [[ "$output" == ok* ]] || die "Hyprland rejected the shader change: $output"
}

notify() {
  command -v notify-send >/dev/null 2>&1 || return 0
  notify-send --app-name=dotfiles --expire-time=2000 "Anti-flashbang" "$1" || true
}

enable_shader() {
  [[ -s "$SHADER" ]] || die "Shader is not installed: $SHADER"
  apply_shader "$SHADER"
  ok "Anti-flashbang enabled"
  notify "Enabled"
}

disable_shader() {
  apply_shader ""
  ok "Anti-flashbang disabled"
  notify "Disabled"
}

main() {
  local arg
  local active

  for arg in "$@"; do
    case "$arg" in
      on | off | toggle | status) ACTION="$arg" ;;
      -h | --help)
        usage
        return
        ;;
      *)
        usage >&2
        die "Unknown argument: $arg"
        ;;
    esac
  done

  command -v hyprctl >/dev/null 2>&1 || die "hyprctl is unavailable"
  active="$(current_shader)"

  case "$ACTION" in
    on) enable_shader ;;
    off) disable_shader ;;
    toggle)
      if [[ "$active" == "$SHADER" ]]; then
        disable_shader
      else
        enable_shader
      fi
      ;;
    status)
      if [[ "$active" == "$SHADER" ]]; then
        printf 'enabled\n'
      elif [[ -n "$active" ]]; then
        printf 'disabled; another screen shader is active: %s\n' "$active"
      else
        printf 'disabled\n'
      fi
      ;;
  esac
}

main "$@"
