#!/usr/bin/env lua

local function shell_quote(value)
  return "'" .. value:gsub("'", "'\\''") .. "'"
end

local function capture(command)
  local handle = io.popen(command .. " 2>/dev/null", "r")
  if not handle then return nil end
  local output = handle:read("*a")
  local ok = handle:close()
  if not ok then return nil end
  return output ~= "" and output or nil
end

local function notify(summary, body, urgency)
  os.execute("notify-send -u " .. shell_quote(urgency or "normal") .. " " .. shell_quote(summary) .. " " .. shell_quote(body) .. " >/dev/null 2>&1")
end

local function load_core()
  local data_home = os.getenv("XDG_DATA_HOME") or ((os.getenv("HOME") or "") .. "/.local/share")
  local candidates = {
    data_home .. "/dotfiles/translation/core.lua",
    (arg[0]:match("^(.*)/bin/") or ".") .. "/share/translation/core.lua",
  }
  for _, path in ipairs(candidates) do
    local file = io.open(path, "r")
    if file then
      file:close()
      return dofile(path)
    end
  end
  error("translation core is not installed")
end

local function read_framed_lines()
  local count = tonumber(io.read("*l") or "")
  if not count or count < 1 or count > 10000 or count % 1 ~= 0 then
    return nil, "Invalid framed stdin line count."
  end

  local lines = {}
  for line_number = 1, count do
    local line = io.read("*l")
    if line == nil then
      return nil, "Incomplete framed stdin input."
    end
    lines[line_number] = line
  end
  return lines
end

local function save_settings(values)
  local source_language = values[1] or ""
  local target_language = values[2] or ""
  local tone = values[3] or ""
  local context = values[4] or ""
  local local_base_url = values[5] or ""
  local local_model = values[6] or ""
  local local_timeout = values[7] or ""
  local local_api_key = values[8] or ""
  local supported_tones = {
    natural = true,
    casual = true,
    humorous = true,
    professional = true,
    concise = true,
  }
  local supported_contexts = {
    general = true,
    social_x = true,
    casual_chat = true,
    professional = true,
    technical = true,
  }
  if not supported_tones[tone] then
    return nil, "Unsupported translation tone."
  end
  if not supported_contexts[context] then
    return nil, "Unsupported translation context."
  end
  if source_language == "" or target_language == "" or tone == "" or context == "" then
    return nil, "Language, tone, and context settings are required."
  end
  for _, value in ipairs(values) do
    if value:match("[\r\n]") then
      return nil, "Translation settings must be single-line values."
    end
  end
  if not local_base_url:match("^https?://%S+$") then
    return nil, "The local API endpoint must be an HTTP or HTTPS URL."
  end
  local timeout_number = tonumber(local_timeout)
  if not timeout_number or timeout_number % 1 ~= 0 or
      timeout_number < 1 or timeout_number > 300 then
    return nil, "The local API timeout must be an integer from 1 to 300 seconds."
  end

  local config_home = os.getenv("XDG_CONFIG_HOME") or ((os.getenv("HOME") or "") .. "/.config")
  local config_directory = config_home .. "/dotfiles"
  local config_path = config_directory .. "/translation.env"
  local replacements = {
    TRANSLATION_SOURCE_LANGUAGE = source_language,
    TRANSLATION_TARGET_LANGUAGE = target_language,
    TRANSLATION_TONE = tone,
    TRANSLATION_CONTEXT = context,
    TRANSLATION_LOCAL_BASE_URL = local_base_url,
    TRANSLATION_LOCAL_MODEL = local_model,
    TRANSLATION_LOCAL_TIMEOUT = local_timeout,
  }
  if local_api_key ~= "" then
    replacements.TRANSLATION_LOCAL_API_KEY = local_api_key
  end
  local lines = {}
  local seen = {}
  local existing = io.open(config_path, "r")
  if existing then
    for line in existing:lines() do
      local key = line:match("^%s*([A-Z][A-Z0-9_]*)%s*=")
      if key and replacements[key] then
        lines[#lines + 1] = key .. "=" .. replacements[key]
        seen[key] = true
      else
        lines[#lines + 1] = line
      end
    end
    existing:close()
  end
  for _, key in ipairs({
    "TRANSLATION_SOURCE_LANGUAGE",
    "TRANSLATION_TARGET_LANGUAGE",
    "TRANSLATION_TONE",
    "TRANSLATION_CONTEXT",
    "TRANSLATION_LOCAL_BASE_URL",
    "TRANSLATION_LOCAL_MODEL",
    "TRANSLATION_LOCAL_TIMEOUT",
  }) do
    if not seen[key] then
      lines[#lines + 1] = key .. "=" .. replacements[key]
    end
  end
  if replacements.TRANSLATION_LOCAL_API_KEY and
      not seen.TRANSLATION_LOCAL_API_KEY then
    lines[#lines + 1] = "TRANSLATION_LOCAL_API_KEY=" ..
      replacements.TRANSLATION_LOCAL_API_KEY
  end

  local made_directory = os.execute("mkdir -p " .. shell_quote(config_directory))
  if not made_directory then
    return nil, "Could not create the translation config directory."
  end
  math.randomseed(os.time())
  local temporary = config_path .. ".tmp." .. tostring(os.time()) .. "." .. tostring(math.random(100000, 999999))
  local file, open_error = io.open(temporary, "wb")
  if not file then return nil, open_error end
  local secured = os.execute("chmod 600 " .. shell_quote(temporary))
  if not secured then
    file:close()
    os.remove(temporary)
    return nil, "Could not secure the temporary translation config."
  end
  file:write(table.concat(lines, "\n"), "\n")
  file:close()
  local renamed, rename_error = os.rename(temporary, config_path)
  if not renamed then
    os.remove(temporary)
    return nil, rename_error
  end
  return true
end

local options = {
  replace = false,
  stdin = false,
  stdin_lines = false,
  stdout = false,
  show_settings = false,
  save_settings = false,
}
local index = 1
while index <= #arg do
  local value = arg[index]
  if value == "--replace" then
    options.replace = true
  elseif value == "--stdin" then
    options.stdin = true
  elseif value == "--stdin-lines" then
    options.stdin_lines = true
  elseif value == "--stdout" then
    options.stdout = true
  elseif value == "--show-settings" then
    options.show_settings = true
  elseif value == "--save-settings" then
    options.save_settings = true
  elseif value == "--source" or value == "--target" or
      value == "--tone" or value == "--context" then
    index = index + 1
    if not arg[index] or arg[index]:match("^%-%-") then
      io.stderr:write("Missing value for " .. value .. "\n")
      os.exit(2)
    end
    local names = {
      ["--source"] = "source_language",
      ["--target"] = "target_language",
      ["--tone"] = "tone",
      ["--context"] = "context",
    }
    options[names[value]] = arg[index]
  elseif value == "--help" or value == "-h" then
    print("Usage: dotfiles-translate [--replace] [--stdin|--stdin-lines] [--stdout] [--source language] [--target language] [--tone natural|casual|humorous|professional|concise] [--context general|social_x|casual_chat|professional|technical]")
    print("       dotfiles-translate --show-settings")
    print("       dotfiles-translate --save-settings < framed input")
    os.exit(0)
  else
    io.stderr:write("Unknown option: " .. tostring(value) .. "\n")
    os.exit(2)
  end
  index = index + 1
end

local core = load_core()
if options.show_settings then
  local config = core.load_config()
  io.write(table.concat({
    config.source_language,
    config.target_language,
    config.tone,
    config.context,
    config.local_base_url,
    config.local_model,
    tostring(config.local_timeout),
    config.local_api_key ~= "" and "configured" or "missing",
  }, "\n"), "\n")
  os.exit(0)
end
if options.save_settings then
  local values, read_error = read_framed_lines()
  if not values then
    io.stderr:write(read_error .. "\n")
    os.exit(2)
  end
  if #values ~= 8 then
    io.stderr:write("Expected eight translation settings.\n")
    os.exit(2)
  end
  local saved, save_error = save_settings(values)
  if not saved then
    io.stderr:write((save_error or "Could not save settings.") .. "\n")
    os.exit(1)
  end
  io.write("saved\n")
  os.exit(0)
end

local source
if options.stdin and options.stdin_lines then
  io.stderr:write("Use only one stdin input mode.\n")
  os.exit(2)
elseif options.stdin_lines then
  local lines, read_error = read_framed_lines()
  if not lines then
    io.stderr:write(read_error .. "\n")
    os.exit(2)
  end
  source = table.concat(lines, "\n")
elseif options.stdin then
  source = io.read("*a")
else
  source = capture("wl-paste --primary --no-newline") or capture("wl-paste --no-newline")
end
if not source or source == "" then
  local message = "Select or copy text before translating."
  if options.stdout then io.stderr:write(message .. "\n") else notify("Translation", message, "normal") end
  os.exit(1)
end

local result, provider, err = core.translate(source, options)
if not result then
  local message = err or "The local translation service returned no result."
  if options.stdout then io.stderr:write(message .. "\n") else notify("Translation failed", message, "critical") end
  os.exit(1)
end

if options.stdout then
  io.write(result)
  os.exit(0)
end

local temporary = os.tmpname()
local file = assert(io.open(temporary, "wb"))
file:write(result)
file:close()
os.execute("chmod 600 " .. shell_quote(temporary))
local copied = os.execute("wl-copy < " .. shell_quote(temporary))
if not copied then
  os.remove(temporary)
  notify("Translation failed", "Could not write the translation to the clipboard.", "critical")
  os.exit(1)
end

if options.replace then
  os.execute("sleep 0.05 && wtype -M ctrl -P v -p v -m ctrl >/dev/null 2>&1")
end
os.remove(temporary)
notify("Translation", "Translated with " .. provider .. ".", "low")
