#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
FAILURES=0
WARNINGS=0

ok() { printf '\033[1;32m[ok]\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m[warn]\033[0m %s\n' "$*" >&2; WARNINGS=$((WARNINGS + 1)); }
fail() { printf '\033[1;31m[fail]\033[0m %s\n' "$*" >&2; FAILURES=$((FAILURES + 1)); }

usage() {
  cat <<'EOF'
Usage: ./check [all|lazygit|yazi|fcitx5|git-identity|onepiece|plymouth|security] [...]
EOF
}

validate_toml() {
  local file="$1"

  if command -v python3 >/dev/null 2>&1; then
    python3 -c 'import pathlib, sys, tomllib; tomllib.loads(pathlib.Path(sys.argv[1]).read_text())' "$file"
  else
    warn "python3 is unavailable; skipped TOML parsing for $file"
  fi
}

check_lazygit() {
  local config="$ROOT/config/lazygit/config.yml"
  [[ -s "$config" ]] || {
    fail "Missing Lazygit config"
    return
  }

  if command -v lazygit >/dev/null 2>&1; then
    if lazygit --use-config-file "$config" --config >/dev/null; then
      ok "Lazygit accepts config.yml"
    else
      fail "Lazygit rejected config.yml"
    fi
  else
    warn "lazygit is unavailable; skipped application-level validation"
  fi
}

check_yazi() {
  local file
  for file in "$ROOT/config/yazi/yazi.toml" "$ROOT/config/yazi/keymap.toml"; do
    if [[ ! -s "$file" ]]; then
      fail "Missing Yazi config: $file"
    elif validate_toml "$file"; then
      ok "Valid TOML: ${file#"$ROOT/"}"
    else
      fail "Invalid TOML: ${file#"$ROOT/"}"
    fi
  done

  if command -v yazi >/dev/null 2>&1; then
    if YAZI_CONFIG_HOME="$ROOT/config/yazi" yazi --debug >/dev/null 2>&1; then
      ok "Yazi accepts the repository config directory"
    else
      fail "Yazi rejected the repository config directory"
    fi
  else
    warn "yazi is not installed; run ./install packages before using this module"
  fi
}

check_fcitx5() {
  local config="$ROOT/config/fcitx5"
  local rime="$ROOT/share/fcitx5/rime"
  local source_revision="$ROOT/sources/rime-japanese.rev"
  local theme="$ROOT/share/fcitx5/themes/catppuccin-macchiato-maroon"
  local file

  for file in \
    "$config/config" \
    "$config/profile" \
    "$config/conf/classicui.conf" \
    "$rime/default.custom.yaml" \
    "$rime/japanese.dict.yaml" \
    "$rime/japanese_tw_eng.schema.yaml" \
    "$rime/rime_ice.custom.yaml" \
    "$rime/sno_japanese.schema.yaml" \
    "$rime/opencc/hiragana_katakana.json" \
    "$rime/opencc/hiragana_katakana.txt" \
    "$source_revision" \
    "$theme/theme.conf"; do
    [[ -s "$file" ]] || fail "Missing input-method file: ${file#"$ROOT/"}"
  done

  grep -q '^DefaultIM=rime$' "$config/profile" ||
    fail "Fcitx5 profile does not select Rime by default"
  grep -q '^Theme=catppuccin-macchiato-maroon$' "$config/conf/classicui.conf" ||
    fail "Fcitx5 Classic UI does not select the bundled theme"
  grep -q 'rime_ice_suggestion' "$rime/default.custom.yaml" ||
    fail "Rime override does not include the Rime Ice suggestion recipe"
  grep -q 'schema: japanese_tw_eng' "$rime/default.custom.yaml" ||
    fail "Rime schema list does not include multilingual input"
  grep -q 'schema: sno_japanese' "$rime/default.custom.yaml" ||
    fail "Rime schema list does not include Japanese input"
  grep -q 'schema_id: japanese_tw_eng' "$rime/japanese_tw_eng.schema.yaml" ||
    fail "Multilingual Rime schema ID is missing"
  grep -q 'schema_id: sno_japanese' "$rime/sno_japanese.schema.yaml" ||
    fail "Japanese Rime schema ID is missing"
  grep -Eq '^[0-9a-f]{40}$' "$source_revision" ||
    fail "Rime Japanese source revision is invalid"
  grep -q 'rime_deployer --build' "$ROOT/install" ||
    fail "Fcitx5 installation does not deploy Rime data"
  grep -q 'systemctl --user restart' "$ROOT/install" ||
    fail "Fcitx5 installation does not restart the Omarchy user service"
  grep -q 'systemctl --user is-active --quiet' "$ROOT/install" ||
    fail "Fcitx5 installation does not verify the restarted service"

  if find "$config" "$rime" \
    \( -type d \( -name build -o -name sync -o -name '*.userdb' \) -prune \) -o \
    -type f \
    \( -name '*.userdb*' -o -name 'user.yaml' -o -name 'installation.yaml' -o \
       -name 'cached_layouts' \) | grep -q .; then
    fail "Runtime or user-specific Fcitx5/Rime data is present"
  else
    ok "No Fcitx5/Rime runtime data is tracked"
  fi

  ok "Fcitx5/Rime module structure is valid"
}

check_git_identity() {
  local script="$ROOT/bin/git-identity"

  [[ -x "$script" ]] || {
    fail "Git identity setup script is missing or not executable"
    return
  }
  if bash -n "$script"; then
    ok "Git identity setup script has valid Bash syntax"
  else
    fail "Git identity setup script has invalid Bash syntax"
  fi
  grep -q -- '--quick-generate-key' "$script" ||
    fail "Git identity setup cannot generate an OpenPGP key"
  grep -q -- '--list-secret-keys' "$script" ||
    fail "Git identity setup does not validate local secret keys"
}

check_language_policy() {
  local documentation_hits
  local comment_hits

  documentation_hits=$(rg -n -P '[\p{Han}]' \
    --glob '*.md' \
    --glob '!share/fcitx5/rime/**' \
    "$ROOT" 2>/dev/null || true)
  comment_hits=$(rg -n -P '^[[:space:]]*(#|//|;).*\p{Han}' \
    --glob '!.git/**' \
    "$ROOT" 2>/dev/null || true)

  if [[ -n "$documentation_hits" || -n "$comment_hits" ]]; then
    fail "Chinese explanatory text or comments are present"
    [[ -n "$documentation_hits" ]] && printf '%s\n' "$documentation_hits" >&2
    [[ -n "$comment_hits" ]] && printf '%s\n' "$comment_hits" >&2
  else
    ok "Documentation and comments follow the English-only policy"
  fi
}

check_onepiece() {
  local theme="$ROOT/omarchy/themes/onepiece"
  local colors="$theme/colors.toml"
  local backgrounds
  local key

  [[ -d "$theme" && ! -L "$theme" ]] || {
    fail "One Piece source must be a real directory"
    return
  }

  if ! validate_toml "$colors"; then
    fail "Invalid One Piece colors.toml"
    return
  fi

  for key in accent foreground background cursor color0 color15; do
    if ! grep -Eq "^[[:space:]]*$key[[:space:]]*=" "$colors"; then
      fail "One Piece colors.toml is missing '$key'"
    fi
  done

  backgrounds=$(find "$theme/backgrounds" -maxdepth 1 -type f \
    \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' -o -iname '*.webp' \) |
    wc -l)
  if (( backgrounds > 0 )); then
    ok "One Piece theme has $backgrounds backgrounds"
  else
    fail "One Piece theme has no supported backgrounds"
  fi

  [[ -s "$theme/icons.theme" ]] || fail "One Piece theme is missing icons.theme"
  ok "One Piece theme structure is valid"
}

check_plymouth() {
  local theme="$ROOT/system/plymouth/themes/zoro"
  local script="$theme/zoro.script"
  local descriptor="$theme/zoro.plymouth"
  local media="$theme/media"
  local max_frame
  local frame
  local missing=0
  local count
  local dimensions

  for frame in "$script" "$descriptor" "$theme/bullet.png" "$theme/entry.png"; do
    [[ -s "$frame" ]] || fail "Missing Plymouth asset: ${frame#"$ROOT/"}"
  done

  max_frame=$(sed -nE 's/.*i <= ([0-9]+).*/\1/p' "$script" | head -n 1)
  [[ "$max_frame" =~ ^[0-9]+$ ]] || {
    fail "Unable to read maximum frame from zoro.script"
    return
  }

  for ((frame = 0; frame <= max_frame; frame++)); do
    [[ -s "$media/$frame.png" ]] || missing=$((missing + 1))
  done
  count=$(find "$media" -maxdepth 1 -type f -name '*.png' | wc -l)

  if (( missing == 0 && count == max_frame + 1 )); then
    ok "Zoro frame sequence is complete: 0..$max_frame"
  else
    fail "Zoro frames do not match script: count=$count missing=$missing max=$max_frame"
  fi

  grep -q '^ImageDir=/usr/share/plymouth/themes/zoro$' "$descriptor" ||
    fail "zoro.plymouth has an unexpected ImageDir"
  grep -q '^ScriptFile=/usr/share/plymouth/themes/zoro/zoro.script$' "$descriptor" ||
    fail "zoro.plymouth has an unexpected ScriptFile"

  if command -v magick >/dev/null 2>&1; then
    dimensions=$(find "$media" -maxdepth 1 -type f -name '*.png' -print0 |
      sort -zV |
      xargs -0 magick identify -format '%wx%h\n' |
      sort -u)
    if [[ $(wc -l <<<"$dimensions") -eq 1 ]]; then
      ok "Zoro frames share dimensions: $dimensions"
    else
      fail "Zoro frames use inconsistent dimensions: $dimensions"
    fi
  else
    warn "ImageMagick is unavailable; skipped Zoro image validation"
  fi

  ok "Zoro Plymouth theme structure is valid"
}

check_security() {
  local suspicious
  local content_hits

  suspicious=$(find "$ROOT" -path "$ROOT/.git" -prune -o -type f \
    \( -iname '*.pem' -o -iname '*.key' -o -iname '*.p12' -o \
       -iname '*.pfx' -o -iname '*.asc' -o -iname 'id_rsa*' -o \
       -iname 'id_ed25519*' \) -print)
  if [[ -n "$suspicious" ]]; then
    fail "Suspicious credential filenames found:$suspicious"
  else
    ok "No credential-like filenames found"
  fi

  if command -v rg >/dev/null 2>&1; then
    content_hits=$(rg -l --hidden --glob '!.git/**' --glob '!check' \
      '(AKIA[0-9A-Z]{16}|github_pat_[A-Za-z0-9_]{20,}|gh[pousr]_[A-Za-z0-9_]{20,}|-----BEGIN (OPENSSH|RSA|EC|DSA) PRIVATE KEY-----)' \
      "$ROOT" 2>/dev/null || true)
    if [[ -n "$content_hits" ]]; then
      fail "Potential credential contents found:$content_hits"
    else
      ok "No common credential signatures found"
    fi
  else
    warn "ripgrep is unavailable; skipped content credential scan"
  fi
}

run_check() {
  case "$1" in
    all)
      check_lazygit
      check_yazi
      check_fcitx5
      check_git_identity
      check_onepiece
      check_plymouth
      check_language_policy
      check_security
      ;;
    lazygit) check_lazygit ;;
    yazi) check_yazi ;;
    fcitx5) check_fcitx5 ;;
    git-identity) check_git_identity ;;
    onepiece) check_onepiece ;;
    plymouth) check_plymouth ;;
    security) check_security ;;
    *) usage; fail "Unknown check: $1" ;;
  esac
}

main() {
  local target

  (($#)) || set -- all
  for target in "$@"; do
    run_check "$target"
  done

  if (( FAILURES > 0 )); then
    printf '\n%d check(s) failed; %d warning(s).\n' "$FAILURES" "$WARNINGS" >&2
    return 1
  fi
  printf '\nAll checks passed with %d warning(s).\n' "$WARNINGS"
}

main "$@"
