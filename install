#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}"
CACHE_HOME="${XDG_CACHE_HOME:-$HOME/.cache}"
BACKUP_ROOT="$STATE_HOME/dotfiles/backups/$(date +%Y%m%d-%H%M%S)"
DRY_RUN=0

info() { printf '\033[1;36m==>\033[0m %s\n' "$*"; }
ok() { printf '\033[1;32m==>\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m==>\033[0m %s\n' "$*" >&2; }
die() { printf '\033[1;31merror:\033[0m %s\n' "$*" >&2; exit 1; }

usage() {
  cat <<'EOF'
Usage: ./install [--dry-run] <module> [module...]

Modules:
  all        Install lazygit, yazi, translation, hypr, looknfeel, fcitx5, and onepiece
  bootstrap  Install packages, mise-managed tools, and all user configuration
  lazygit    Link the Lazygit configuration
  yazi       Link the Yazi configuration
  tools      Link the global mise configuration and install its declared tools
  translation Install translation commands, Neovim support, and the Omarchy panel
  hypr       Copy the Hyprland input and keybinding configuration
  looknfeel  Copy the Hyprland appearance overrides
  fcitx5     Copy Fcitx5/Rime preferences and the Catppuccin theme
  onepiece   Copy the One Piece theme into the Omarchy user theme directory
  plymouth   Install Zoro system-wide and rebuild the initramfs
  packages   Install packages listed in packages/official.txt through Omarchy

Options:
  --dry-run  Show intended changes without writing
  -h, --help Show this help
EOF
}

show_command() {
  printf '  '
  printf '%q ' "$@"
  printf '\n'
}

run() {
  if (( DRY_RUN )); then
    show_command "$@"
  else
    "$@"
  fi
}

backup_user_path() {
  local path="$1"
  local name="$2"

  [[ -e "$path" || -L "$path" ]] || return 0
  info "Backing up $path"
  run mkdir -p "$BACKUP_ROOT/$(dirname "$name")"
  run mv -- "$path" "$BACKUP_ROOT/$name"
}

install_linked_config() {
  local name="$1"
  local src="$ROOT/config/$name"
  local dest="$CONFIG_HOME/$name"

  [[ -d "$src" ]] || die "Missing source directory: $src"

  if [[ -L "$dest" && $(readlink "$dest") == "$src" ]]; then
    ok "$name is already linked"
    return
  fi

  backup_user_path "$dest" "$name"
  run mkdir -p "$CONFIG_HOME"
  run ln -s "$src" "$dest"
  ok "Installed $name"
}

install_copied_file() {
  local src="$1"
  local dest="$2"
  local backup_name="$3"

  [[ -f "$src" ]] || die "Missing source file: $src"
  if [[ -f "$dest" && ! -L "$dest" ]] && cmp -s "$src" "$dest"; then
    return
  fi

  backup_user_path "$dest" "$backup_name"
  run mkdir -p "$(dirname "$dest")"
  run cp -a "$src" "$dest"
}

install_copied_directory() {
  local src="$1"
  local dest="$2"
  local backup_name="$3"

  [[ -d "$src" && ! -L "$src" ]] || die "Missing source directory: $src"
  if [[ -d "$dest" && ! -L "$dest" ]] && diff -qr "$src" "$dest" >/dev/null; then
    return
  fi

  backup_user_path "$dest" "$backup_name"
  run mkdir -p "$(dirname "$dest")"
  run cp -a "$src" "$dest"
}

prepare_pinned_git_source() {
  local url="$1"
  local revision="$2"
  local dest="$3"
  local current_revision
  shift 3

  if [[ -d "$dest/.git" ]]; then
    current_revision="$(git -C "$dest" rev-parse HEAD 2>/dev/null || true)"
    [[ "$current_revision" == "$revision" ]] ||
      die "Cached source has an unexpected revision: $dest"
    return
  fi

  [[ ! -e "$dest" ]] || die "Source cache path already exists: $dest"
  info "Preparing pinned source $url at ${revision:0:12}"
  run mkdir -p "$dest"
  run git -C "$dest" init -q
  run git -C "$dest" remote add origin "$url"
  run git -C "$dest" sparse-checkout init --no-cone
  run git -C "$dest" sparse-checkout set --no-cone "$@"
  run git -C "$dest" fetch --depth 1 --filter=blob:none origin "$revision"
  run git -C "$dest" checkout -q --detach FETCH_HEAD
}

deploy_rime() {
  local rime_dest="$1"
  local rime_build="$rime_dest/build"
  local deploy_log="$STATE_HOME/dotfiles/rime-deploy.log"

  command -v rime_deployer >/dev/null 2>&1 ||
    die "rime_deployer is required; install fcitx5-rime before this module"

  info "Deploying Rime schemas and dictionaries"
  mkdir -p "$rime_build" "$(dirname "$deploy_log")"
  if ! rime_deployer \
    --build "$rime_dest" /usr/share/rime-data "$rime_build" \
    >"$deploy_log" 2>&1; then
    tail -n 80 "$deploy_log" >&2
    die "Rime deployment failed; see $deploy_log"
  fi
  ok "Deployed Rime configuration"
}

activate_fcitx5_configuration() {
  local service="omarchy-fcitx5.service"

  if command -v systemctl >/dev/null 2>&1 &&
    systemctl --user cat "$service" >/dev/null 2>&1; then
    info "Restarting $service"
    systemctl --user restart "$service" ||
      die "Failed to restart $service"
    systemctl --user is-active --quiet "$service" ||
      die "$service is not active after restart"
    ok "Restarted Fcitx5 through the Omarchy user service"
    return
  fi

  command -v fcitx5-remote >/dev/null 2>&1 ||
    die "Fcitx5 is not managed by Omarchy and fcitx5-remote is unavailable"
  warn "$service is unavailable; reloading the running Fcitx5 instance"
  fcitx5-remote -r ||
    die "Failed to reload the running Fcitx5 instance"
  ok "Reloaded Fcitx5 configuration"
}

install_fcitx5() {
  local src="$ROOT/config/fcitx5"
  local dest="$CONFIG_HOME/fcitx5"
  local rime_src="$ROOT/share/fcitx5/rime"
  local rime_dest="$DATA_HOME/fcitx5/rime"
  local japanese_revision_file="$ROOT/sources/rime-japanese.rev"
  local japanese_url="https://github.com/gkovacs/rime-japanese.git"
  local japanese_revision
  local japanese_cache
  local snomiao_revision_file="$ROOT/sources/rime-snomiao.rev"
  local snomiao_url="https://github.com/snomiao/rime-snomiao.git"
  local snomiao_revision
  local snomiao_cache
  local theme_name="catppuccin-macchiato-maroon"
  local theme_src="$ROOT/share/fcitx5/themes/$theme_name"
  local theme_dest="$DATA_HOME/fcitx5/themes/$theme_name"
  local rime_files=(
    default.custom.yaml
    japanese.dict.yaml
    japanese_pinyin.schema.yaml
    japanese_tw_eng.schema.yaml
    rime_ice.custom.yaml
    sno_japanese.schema.yaml
    translate_en2jp.schema.yaml
  )
  local rime_opencc_files=(
    hiragana_katakana.json
    hiragana_katakana.txt
    jpzh.json
    zhjp.json
  )
  local japanese_dictionary_files=(
    japanese.jmdict.dict.yaml
    japanese.kana.dict.yaml
    japanese.mozc.dict.yaml
  )
  local snomiao_dictionary_files=(
    japanese_chars.dict.yaml
    japanese_pinyin.dict.yaml
    japanese_pinyin_simp.dict.yaml
    pinyin_simp.dict.yaml
    translate_en2jp.dict.yaml
    opencc/zhjp_daily.txt
    opencc/zhjp_word.txt
  )
  local file
  local name
  local obsolete_rime_files=(
    lua/translation.lua
    rime.lua
  )

  "$ROOT/check" fcitx5
  read -r japanese_revision < "$japanese_revision_file"
  [[ "$japanese_revision" =~ ^[0-9a-f]{40}$ ]] ||
    die "Invalid Rime Japanese source revision"
  japanese_cache="$CACHE_HOME/dotfiles/sources/rime-japanese/$japanese_revision"
  read -r snomiao_revision < "$snomiao_revision_file"
  [[ "$snomiao_revision" =~ ^[0-9a-f]{40}$ ]] ||
    die "Invalid Rime Snomiao source revision"
  snomiao_cache="$CACHE_HOME/dotfiles/sources/rime-snomiao/$snomiao_revision"

  if [[ -L "$dest" ]]; then
    backup_user_path "$dest" "fcitx5-directory"
  fi
  run mkdir -p "$dest/conf"

  install_copied_file "$src/config" "$dest/config" "fcitx5-config"
  install_copied_file "$src/profile" "$dest/profile" "fcitx5-profile"
  for file in "$src"/conf/*.conf; do
    name="$(basename "$file")"
    install_copied_file "$file" "$dest/conf/$name" "fcitx5-conf-$name"
  done

  for name in "${rime_files[@]}"; do
    install_copied_file \
      "$rime_src/$name" \
      "$rime_dest/$name" \
      "fcitx5-rime-$name"
  done
  for name in "${obsolete_rime_files[@]}"; do
    if [[ -e "$rime_dest/$name" || -L "$rime_dest/$name" ]]; then
      info "Removing obsolete Rime translation entry point: $name"
      run mkdir -p "$BACKUP_ROOT/fcitx5-rime-obsolete/$(dirname "$name")"
      run mv -- "$rime_dest/$name" "$BACKUP_ROOT/fcitx5-rime-obsolete/$name"
    fi
  done
  for name in "${rime_opencc_files[@]}"; do
    install_copied_file \
      "$rime_src/opencc/$name" \
      "$rime_dest/opencc/$name" \
      "fcitx5-rime-opencc-$name"
  done

  prepare_pinned_git_source \
    "$japanese_url" \
    "$japanese_revision" \
    "$japanese_cache" \
    "${japanese_dictionary_files[@]}"
  for name in "${japanese_dictionary_files[@]}"; do
    if (( DRY_RUN )) && [[ ! -f "$japanese_cache/$name" ]]; then
      show_command cp -a "$japanese_cache/$name" "$rime_dest/$name"
    else
      install_copied_file \
        "$japanese_cache/$name" \
        "$rime_dest/$name" \
        "fcitx5-rime-$name"
    fi
  done

  prepare_pinned_git_source \
    "$snomiao_url" \
    "$snomiao_revision" \
    "$snomiao_cache" \
    "${snomiao_dictionary_files[@]/#/Rime/}"
  for name in "${snomiao_dictionary_files[@]}"; do
    if (( DRY_RUN )) && [[ ! -f "$snomiao_cache/Rime/$name" ]]; then
      show_command cp -a "$snomiao_cache/Rime/$name" "$rime_dest/$name"
    else
      install_copied_file \
        "$snomiao_cache/Rime/$name" \
        "$rime_dest/$name" \
        "fcitx5-rime-${name//\//-}"
    fi
  done
  install_copied_directory "$theme_src" "$theme_dest" "fcitx5-theme-$theme_name"

  if (( ! DRY_RUN )); then
    deploy_rime "$rime_dest"
    activate_fcitx5_configuration
  fi
  ok "Installed Fcitx5/Rime preferences"
}

install_hypr() {
  local name

  "$ROOT/check" hypr
  for name in input.lua bindings.lua; do
    install_copied_file \
      "$ROOT/config/hypr/$name" \
      "$CONFIG_HOME/hypr/$name" \
      "hypr-$name"
  done

  if (( ! DRY_RUN )) && command -v hyprctl >/dev/null 2>&1; then
    hyprctl reload
    hyprctl configerrors
  fi
  ok "Installed Hyprland input configuration"
}

install_looknfeel() {
  local config_src="$ROOT/config/hypr/looknfeel.lua"
  local config_dest="$CONFIG_HOME/hypr/looknfeel.lua"

  "$ROOT/check" looknfeel
  install_copied_file "$config_src" "$config_dest" "hypr-looknfeel.lua"

  if (( ! DRY_RUN )) && command -v hyprctl >/dev/null 2>&1; then
    hyprctl reload
    hyprctl configerrors
  fi
  ok "Installed Hyprland appearance overrides"
}

install_translation() {
  local command_src="$ROOT/bin/dotfiles-translate"
  local command_dest="$HOME/.local/bin/dotfiles-translate"
  local core_src="$ROOT/share/translation/core.lua"
  local core_dest="$DATA_HOME/dotfiles/translation/core.lua"
  local example_src="$ROOT/config/translation/translation.env.example"
  local example_dest="$CONFIG_HOME/dotfiles/translation.env.example"
  local private_config="$CONFIG_HOME/dotfiles/translation.env"
  local nvim_plugin_src="$ROOT/share/nvim/site/plugin/dotfiles-translation.lua"
  local nvim_plugin_dest="$DATA_HOME/nvim/site/plugin/dotfiles-translation.lua"
  local omarchy_plugin_src="$ROOT/omarchy/plugins/local.translation"
  local omarchy_plugin_dest="$CONFIG_HOME/omarchy/plugins/local.translation"

  "$ROOT/check" translation
  install_copied_file "$command_src" "$command_dest" "dotfiles-translate"
  install_copied_file "$core_src" "$core_dest" "translation-core.lua"
  install_copied_file "$example_src" "$example_dest" "translation.env.example"
  install_copied_file "$nvim_plugin_src" "$nvim_plugin_dest" "nvim-site-plugin-dotfiles-translation.lua"
  install_copied_directory "$omarchy_plugin_src" "$omarchy_plugin_dest" "omarchy-plugin-local.translation"
  run chmod 0755 "$command_dest"

  if [[ ! -e "$private_config" ]]; then
    run cp -a "$example_src" "$private_config"
    run chmod 0600 "$private_config"
    info "Created private translation config: $private_config"
  fi
  if (( DRY_RUN )); then
    show_command omarchy plugin rescan
    show_command omarchy plugin enable local.translation
    show_command omarchy bar plugin move local.translation --section right --index 0
  elif command -v omarchy >/dev/null 2>&1 && omarchy-shell shell ping >/dev/null 2>&1; then
    omarchy plugin rescan
    omarchy plugin enable local.translation
    omarchy bar plugin move local.translation --section right --index 0
  else
    warn "Omarchy Shell is unavailable; enable local.translation after the shell starts"
  fi
  ok "Installed global translation support"
}

install_onepiece() {
  local src="$ROOT/omarchy/themes/onepiece"
  local parent="$CONFIG_HOME/omarchy/themes"
  local dest="$parent/onepiece"

  "$ROOT/check" onepiece

  if [[ -d "$dest" && ! -L "$dest" ]] && diff -qr "$src" "$dest" >/dev/null; then
    ok "onepiece is already installed"
    return
  fi

  backup_user_path "$dest" "omarchy-theme-onepiece"
  run mkdir -p "$parent"
  run cp -a "$src" "$dest"
  ok "Installed the One Piece Omarchy theme"
  info "Activate it manually with: omarchy theme set onepiece"
}

rebuild_initramfs() {
  if command -v limine-mkinitcpio >/dev/null 2>&1; then
    sudo limine-mkinitcpio
  else
    sudo mkinitcpio -P
  fi
}

install_plymouth() {
  local theme="zoro"
  local src="$ROOT/system/plymouth/themes/$theme"
  local themes_root="/usr/share/plymouth/themes"
  local dest="$themes_root/$theme"
  local stage="$themes_root/.${theme}.dotfiles.$$"
  local system_backup_root="/var/lib/dotfiles/backups/plymouth"
  local system_backup="$system_backup_root/${theme}.$(date +%Y%m%d-%H%M%S)"
  local previous_theme
  local had_existing=0

  "$ROOT/check" plymouth
  previous_theme="$(plymouth-set-default-theme 2>/dev/null || true)"

  if (( DRY_RUN )); then
    info "Would install Plymouth theme '$theme' (current: ${previous_theme:-unknown})"
    show_command sudo install -d -m 0755 "$stage"
    show_command sudo cp -a "$src/." "$stage/"
    [[ -e "$dest" ]] && show_command sudo mv "$dest" "$system_backup"
    show_command sudo mv "$stage" "$dest"
    show_command sudo plymouth-set-default-theme "$theme"
    if command -v limine-mkinitcpio >/dev/null 2>&1; then
      show_command sudo limine-mkinitcpio
    else
      show_command sudo mkinitcpio -P
    fi
    return
  fi

  info "Installing Plymouth theme '$theme'"
  sudo -v
  sudo install -d -m 0755 "$stage"
  sudo cp -a "$src/." "$stage/"

  if sudo test -e "$dest"; then
    had_existing=1
    sudo install -d -m 0755 "$system_backup_root"
    sudo mv "$dest" "$system_backup"
  fi
  sudo mv "$stage" "$dest"

  if ! sudo plymouth-set-default-theme "$theme" || ! rebuild_initramfs; then
    warn "Plymouth rebuild failed; restoring the previous selection"
    sudo mv "$dest" "${dest}.failed.$(date +%Y%m%d-%H%M%S)" || true
    if (( had_existing )); then
      sudo mv "$system_backup" "$dest" || true
    fi
    if [[ -n "$previous_theme" ]]; then
      sudo plymouth-set-default-theme "$previous_theme" || true
      rebuild_initramfs || true
    fi
    die "Plymouth installation failed; the new files were preserved with a .failed suffix"
  fi

  ok "Installed and activated Plymouth theme '$theme'"
  [[ -n "$previous_theme" ]] && info "Previous Plymouth theme: $previous_theme"
}

install_packages() {
  local official_file="$ROOT/packages/official.txt"
  local aur_file="$ROOT/packages/aur.txt"
  local official=()
  local aur=()
  local line

  while IFS= read -r line; do
    line="${line%%#*}"
    line="${line#"${line%%[![:space:]]*}"}"
    line="${line%"${line##*[![:space:]]}"}"
    [[ -n "$line" ]] && official+=("$line")
  done < "$official_file"

  while IFS= read -r line; do
    line="${line%%#*}"
    line="${line#"${line%%[![:space:]]*}"}"
    line="${line%"${line##*[![:space:]]}"}"
    [[ -n "$line" ]] && aur+=("$line")
  done < "$aur_file"

  if (( DRY_RUN )); then
    ((${#official[@]})) && show_command omarchy pkg add "${official[@]}"
    ((${#aur[@]})) && show_command omarchy pkg aur add "${aur[@]}"
  else
    ((${#official[@]})) && omarchy pkg add "${official[@]}"
    ((${#aur[@]})) && omarchy pkg aur add "${aur[@]}"
  fi
}

install_tools() {
  command -v mise >/dev/null 2>&1 ||
    die "mise is required; install it before the tools module"

  install_linked_config mise
  info "Installing tools declared in the global mise configuration"
  if (( DRY_RUN )); then
    show_command mise install
  else
    mise install
  fi
  ok "Installed mise-managed tools"
}

install_user_modules() {
  install_linked_config lazygit
  install_linked_config yazi
  install_translation
  install_hypr
  install_looknfeel
  install_fcitx5
  install_onepiece
}

install_bootstrap() {
  install_packages
  install_tools
  install_user_modules
}

main() {
  local modules=()
  local arg

  for arg in "$@"; do
    case "$arg" in
      --dry-run) DRY_RUN=1 ;;
      -h|--help) usage; return ;;
      *) modules+=("$arg") ;;
    esac
  done

  ((${#modules[@]})) || {
    usage
    return 1
  }

  for arg in "${modules[@]}"; do
    case "$arg" in
      all) install_user_modules ;;
      bootstrap) install_bootstrap ;;
      lazygit|yazi) install_linked_config "$arg" ;;
      tools) install_tools ;;
      translation) install_translation ;;
      hypr) install_hypr ;;
      looknfeel) install_looknfeel ;;
      fcitx5) install_fcitx5 ;;
      onepiece) install_onepiece ;;
      plymouth) install_plymouth ;;
      packages) install_packages ;;
      *) die "Unknown module: $arg" ;;
    esac
  done
}

main "$@"
